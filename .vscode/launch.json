{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Django: runserver (automl_core upload UI)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/manage.py",
            "args": ["runserver"],
            "django": true,
            "cwd": "${workspaceFolder}/src",
            "env": {
                "DJANGO_SETTINGS_MODULE": "config.settings"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Python: pytest tests/",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["tests/", "-q"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
